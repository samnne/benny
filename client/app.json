{
  "expo": {
    "name": "benny",
    "slug": "benny",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-light.png",
    "scheme": "benny",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.samuelechefu.benny",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "platforms": [
      "ios"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Benny to access your camera to scan receipts! This is required to use the receipt scanning feature."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Fredoka-Regular.ttf",
            "./assets/fonts/Fredoka-Medium.ttf",
            "./assets/fonts/Fredoka-SemiBold.ttf",
            "./assets/fonts/Fredoka-Light.ttf",
            "./assets/fonts/Fredoka-Bold.ttf",
            "./assets/fonts/Nunito-Regular.ttf",
            "./assets/fonts/Nunito-Medium.ttf",
            "./assets/fonts/Nunito-SemiBold.ttf",
            "./assets/fonts/Nunito-Bold.ttf",
            "./assets/fonts/Nunito-ExtraBold.ttf",
            "./assets/fonts/Nunito-Black.ttf"
          ]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBAnalytics",
              "RNFBApp",
              "RNFBAppCheck",
              "RNFBAuth",
              "RNFBCrashlytics",
              "RNFBFirestore",
              "RNFBMessaging",
              "RNFBRemoteConfig",
              "RNFBStorage",
              "RNFBSomeOtherRNFBModuleYouAreUsing"
            ]
          }
        }
      ],
      "expo-apple-authentication",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2c92635-4742-43de-95e3-5c404d76f17a"
      }
    },
    "owner": "samuelechefu"
  }
}
